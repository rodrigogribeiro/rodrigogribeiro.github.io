{%- comment -%} Local override: shows only the news items in the current page language (en / pt-BR). {%- endcomment -%}
{%- if page.lang contains 'pt' -%}{%- assign cur_lang = 'pt' -%}{%- else -%}{%- assign cur_lang = 'en' -%}{%- endif -%}
{%- assign news = site.news | where_exp: 'item', 'item.lang == cur_lang' | reverse -%}
<div class="news">
  {% if news != empty %}
    {% assign news_size = news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">
              {% if cur_lang == 'pt' %}{{ item.date | date: '%d/%m/%Y' }}{% else %}{{ item.date | date: '%b %d, %Y' }}{% endif %}
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>{% if cur_lang == 'pt' %}Nenhuma notícia por enquanto.{% else %}No news so far...{% endif %}</p>
  {% endif %}
</div>
